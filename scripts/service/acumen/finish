#!/data/data/com.termux/files/usr/bin/sh
# runsv 在服务终止后、重启前执行本脚本（退出码在 $1、信号在 $2）。部署到
# $PREFIX/var/service/acumen/finish，权限 755。
#
# 为什么需要：runsv 自身没有退避，run 脚本秒退时它约每 1.25 秒重试一次（实测 20 秒
# 起 16 次）。配置解析失败、二进制缺失、启动锁被占这类「一起来就退」的情况会一直
# 热循环，白烧 CPU 并把日志刷爆。所以秒退就退避；活得久说明是运行中偶发退出，
# 立刻重启，不影响正常崩溃恢复。
#
# 人为停止不退避。实测 bot 接住 SIGTERM/SIGINT 后是**正常退出**（退出码 0、信号 0，
# 日志以「Bye!」结尾），所以判据是退出码 0 而不是信号；进程直接被信号打死的情况
# （退出码 -1、信号 15/2）也一并放过。
#
# 注意 runsv 在 finish 里跑 sleep 时 `sv up` 不会立刻生效，要等 sleep 结束——
# 这也是人为停止必须走豁免这条路的原因。
MIN_UPTIME=${ACUMEN_MIN_UPTIME:-20}
STAMP=${PREFIX:-/data/data/com.termux/files/usr}/var/run/acumen.started

if [ "$1" = "0" ]; then
    exit 0
fi
if [ "$1" = "-1" ] && { [ "$2" = "15" ] || [ "$2" = "2" ]; }; then
    exit 0
fi

if [ -r "$STAMP" ]; then
    ran=$(( $(date +%s) - $(cat "$STAMP" 2>/dev/null || echo 0) ))
    if [ "$ran" -lt "$MIN_UPTIME" ]; then
        echo "acumen: 只活了 ${ran}s（退出码 $1 / 信号 $2），退避 ${MIN_UPTIME}s 再试"
        sleep "$MIN_UPTIME"
    fi
fi
exit 0
