<?xml version="1.0" encoding="utf-8"?>
<!--
  控制台是这台机器上的一个 HTTP 服务（默认 127.0.0.1:7801），没有证书可说。
  放行明文是必须的，但真正的门不是 TLS 而是那道口令：它由核心生成、
  存在 data/console/token，WebView 只把它交给这一个来源。
  导航本身另有限制：ConsoleActivity 只允许停在控制台的 origin 上，
  页面里点出去的外链一律交给系统浏览器。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
