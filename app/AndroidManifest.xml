<?xml version="1.0" encoding="utf-8"?>
<!--
  知言（com.araea.zhiyan）
  ───────────────────────────────────────────────────────────────────────────
  这是一个壳：界面是控制台服务发过来的那张网页，壳只负责三件事：把核心跑起来、
  把网页放进 WebView、把两者的生命周期绑在一起。所以这里没有复杂的东西，
  有意义的只有下面这几条权限与那个前台服务的类型。

  minSdk 26：自适应图标与通知渠道都要它，而这也正好是 2017 年之后的机器。
  targetSdk 35：跟机器上那份 android-35 的 android.jar 对齐。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.araea.zhiyan"
    android:versionCode="1"
    android:versionName="0.1.0">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />

    <!-- 连实现端（Satori）要用网络；控制台本身走回环，不需要额外的权限。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 核心是个常驻进程：前台服务 + 唤醒锁，避免息屏后被系统按下去。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/ZhiyanTheme"
        android:networkSecurityConfig="@xml/network_security_config"
        android:hardwareAccelerated="true"
        android:extractNativeLibs="true"
        android:allowBackup="false">

        <activity
            android:name=".ConsoleActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|smallestScreenSize|screenLayout"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".CoreService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="在本机常驻运行知言核心，处理聊天事件与定时任务" />
        </service>
    </application>
</manifest>
