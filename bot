#!/bin/sh
# Foreground launcher and process controls for this checkout (Linux / Termux).
# Termux has no /usr/bin/env without termux-exec (widgets, cron, tmux servers
# started elsewhere), so start under /bin/sh and hand over to bash on PATH.
[ -n "${BASH_VERSION:-}" ] || exec bash "$0" "$@"
set -euo pipefail
bot_script=$(realpath -- "${BASH_SOURCE[0]}")
bot_dir=$(cd -- "$(dirname -- "$bot_script")" && pwd -P)
bot_exe="$bot_dir/target/release/ayjx"
bot_session=ayjx
prefix=${PREFIX:-/data/data/com.termux/files/usr}
svdir=${SVDIR:-$prefix/var/service}
bot_log=${AYJX_LOG:-$prefix/var/log/sv/$bot_session/current}
# sv/sv-enable/sv-disable 从 $SVDIR 找服务目录，非登录 shell 下可能没导出。
export SVDIR="$svdir"
# 根侧看守（Android 专用，脚本在仓库 scripts/ 下）的部署位置与日志。
# /data/adb 是 700 root，普通用户连遍历都不行，所以用 /data/local/tmp 里可读的日志
# 判断它是否在跑；没在跑就不在 help 里提这套东西。
revive=${AYJX_REVIVE:-/data/adb/termux-revive/termux-revive.sh}
revive_log=${AYJX_REVIVE_LOG:-/data/local/tmp/termux-revive.log}

is_our_process() {
    local executable
    executable=$(readlink "/proc/$1/exe" 2>/dev/null) || return 1
    [[ "${executable% (deleted)}" == "$bot_exe" ]]
}

running_pids() {
    local pid
    while read -r pid; do
        if is_our_process "$pid"; then
            printf '%s\n' "$pid"
        fi
    # Android's pgrep may compare argv[0] (the full path) even with -x.
    # Find candidates by command line, then verify /proc/PID/exe above.
    done < <(pgrep -f '/target/release/ayjx' || true)
}

# 本仓库的 ayjx 是否由 runit 托管。托管时进程的生死归 runsv 管，
# start/stop 必须走 sv，直接 kill 会被立刻拉回来。
# 只判断「$SVDIR/ayjx 存在」不够：tests/ 会把这份脚本复制到临时目录里跑，
# 那种情况必须按「未托管」处理，否则 start/stop 会去动真正在跑的那个服务。
# 所以要求 run 脚本里出现本 checkout 的绝对路径（见 docs/CONTROL.md 的服务文件）。
runit_managed() {
    [[ -f "$svdir/$bot_session/run" ]] || return 1
    grep -qF -- "$bot_dir" "$svdir/$bot_session/run" 2>/dev/null
}

wait_gone() {
    local attempt
    for ((attempt = 0; attempt < 35; attempt++)); do
        [[ -z "$(running_pids)" ]] && return 0
        sleep 1
    done
    return 1
}

stop_bot() {
    local pids pid
    pids=$(running_pids)
    if [[ -z "$pids" ]]; then
        printf 'ayjx 已停止。\n'
        return
    fi
    while read -r pid; do
        if is_our_process "$pid"; then kill -TERM "$pid"; fi
    done <<< "$pids"
    if wait_gone; then
        printf 'ayjx 进程已退出；请在前台日志确认配置保存结果。\n'
        return
    fi
    printf '停止超时，请检查前台日志；未强制杀死进程。\n' >&2
    return 1
}

# 收掉 cdp-html-shot 留下的浏览器僵尸。
#
# crate 只在正常析构时 kill 浏览器（BrowserProcess::drop，见 cdp-html-shot
# src/browser.rs），所以 bot 被 SIGKILL、panic-abort、或走 std::process::exit()
# 时不会执行——浏览器变成孤儿，一直占内存又没有任何作用。
#
# 判据三条，缺一不可：
#   1. 命令行同时带 --user-data-dir= 与 cdp-shot_，也就是 cdp-html-shot 拉起的
#      那棵浏览器（主进程和它的 renderer/gpu 子进程都带）。只按 cdp-shot_ 匹配
#      会误伤「命令行里恰好提到这个字符串」的无关进程——我自己就被这么打死过一次。
#   2. 不在本进程的祖先链上。reap 可能被命令行里带这个字符串的 shell 调起来。
#   3. 往上找不到活着的 ayjx 祖先。不用「ppid 是不是 1」——孤儿 reparent 到哪
#      取决于链路上有没有 subreaper（实测有落到别的进程而非 init 的情况）。
#      认 ayjx 用可执行文件名而不是路径，这样从临时目录跑的测试实例也算祖先，
#      不会误杀测试中的浏览器。
own_ancestors() {
    local pid=$$ hops=0 out=""
    while [[ -n "$pid" && "$pid" != "0" && "$pid" != "1" && "$hops" -lt 40 ]]; do
        out="$out $pid"
        pid=$(sed 's/.*) //' "/proc/$pid/stat" 2>/dev/null | cut -d' ' -f2)
        [[ -n "$pid" ]] || break
        hops=$((hops + 1))
    done
    printf '%s' "$out"
}

is_ayjx_pid() {
    local exe
    exe=$(readlink "/proc/$1/exe" 2>/dev/null) || return 1
    exe=${exe% (deleted)}
    [[ $(basename -- "$exe") == ayjx* ]]
}

has_live_ayjx_ancestor() {
    local pid=$1 hops=0
    while [[ -n "$pid" && "$pid" != "0" && "$pid" != "1" && "$hops" -lt 40 ]]; do
        pid=$(sed 's/.*) //' "/proc/$pid/stat" 2>/dev/null | cut -d' ' -f2)
        [[ -n "$pid" ]] || return 1
        is_ayjx_pid "$pid" && return 0
        hops=$((hops + 1))
    done
    return 1
}

reap_orphan_browsers() {
    local pass pid reaped total=0 ancestors
    ancestors=$(own_ancestors)
    # Chromium 会派生 renderer/gpu 等子进程，杀掉主进程后它们可能再被 reparent，
    # 所以多跑几轮直到没有新的可收。
    for pass in 1 2 3; do
        reaped=0
        while read -r pid; do
            [[ -n "$pid" ]] || continue
            grep -qa -- '--user-data-dir=.*cdp-shot_' "/proc/$pid/cmdline" 2>/dev/null || continue
            case " $ancestors " in *" $pid "*) continue ;; esac
            has_live_ayjx_ancestor "$pid" && continue
            if kill -KILL "$pid" 2>/dev/null; then
                reaped=$((reaped + 1))
            fi
        done < <(pgrep -f 'cdp-shot_' 2>/dev/null || true)
        total=$((total + reaped))
        [[ "$reaped" -gt 0 ]] || break
        sleep 1
    done
    if [[ "$total" -gt 0 ]]; then
        printf 'bot: 收掉 %s 个孤儿浏览器进程（没有活着的 ayjx 祖先的 cdp-shot 浏览器）\n' "$total"
    fi
}

# start / console / serve 共用的准备：定位、锁、代理绕行、termux-exec、唤醒锁。
# 参数 lock / nolock：runsv 保证同一时刻只有一个 run 实例，所以托管路径（serve）
# 不加锁。加锁那支只在手动启动时用，而且它有已知副作用——见下面的注释。
prepare_runtime() {
    local want_lock=${1:-lock}
    cd -- "$bot_dir"
    if [[ ! -x "$bot_exe" ]]; then
        printf '请先运行 cargo build --release。\n' >&2
        exit 1
    fi
    if [[ -n "$(running_pids)" ]]; then
        if runit_managed; then
            printf 'ayjx 已由 runit 托管；用 ./bot logs 看日志，./bot restart 重启。\n' >&2
        else
            printf '本仓库的 ayjx 已运行；用 ./bot logs 看日志或 ./bot status 查看。\n' >&2
        fi
        exit 1
    fi
    # 上一次 bot 非正常退出可能留下浏览器僵尸，先收掉再起新的。
    reap_orphan_browsers
    # flock 的 fd 会被 bot 派生出的 Chromium 继承，而那个浏览器可能比 bot 活得久，
    # 于是锁被一个已经无关的进程攥着，后续启动全部报「锁被占用」（2026-09-14 踩过，
    # 表现是托管服务连续退出码 1 起不来）。所以托管路径不加锁；手动路径保留加锁，
    # 但把失败原因写清楚。
    if [[ "$want_lock" == lock ]]; then
        exec 9>"$bot_dir/.bot.lock"
        if ! flock -n 9; then
            printf '启动锁 .bot.lock 被占用。\n' >&2
            printf '多半是上一次的 bot 或它派生的 Chromium 还活着——Chromium 会继承这把锁的 fd，\n' >&2
            printf '即使 bot 已经退出也可能继续攥着。./bot status 看进程；确认没有 ayjx 后，\n' >&2
            printf '按 --user-data-dir 里的 cdp-shot_* 目录找到残留 chromium 杀掉再试。\n' >&2
            exit 1
        fi
    fi
    # Keep local Satori HTTP requests out of environment HTTP proxies.
    export NO_PROXY="${NO_PROXY:+$NO_PROXY,}127.0.0.1,localhost,::1"
    export no_proxy="${no_proxy:+$no_proxy,}127.0.0.1,localhost,::1"
    # Termux app shells export termux-exec's $LD_PRELOAD; sessions started from
    # elsewhere (widgets, cron, a tmux server inherited from another tool) do not.
    # Without it the bot cannot spawn `#!/usr/bin/env` scripts from its tools.
    if [[ -z "${LD_PRELOAD:-}" ]]; then
        for lib in "$prefix/lib/libtermux-exec-ld-preload.so" "$prefix/lib/libtermux-exec.so"; do
            if [[ -f "$lib" ]]; then
                export LD_PRELOAD="$lib"
                break
            fi
        done
    fi
    if [[ "${AYJX_WAKE_LOCK:-1}" == 1 ]] && command -v termux-wake-lock >/dev/null; then
        termux-wake-lock || printf '未能取得 Termux 唤醒锁，请检查通知中的 Acquire wakelock。\n' >&2
    fi
}

# tmux 里挂一个 tail -F $bot_log 的窗口。bot 本身由 runsv 托管，这里只负责看。
open_log_view() {
    command -v tmux >/dev/null || { printf '需要安装 tmux。\n' >&2; exit 1; }
    if tmux has-session -t "=$bot_session-log" 2>/dev/null; then
        printf '日志窗口已存在，使用 ./bot attach 进入。\n'
        return
    fi
    tmux new-session -d -s "$bot_session-log" -c "$bot_dir" \
        "tail -n 200 -F '$bot_log'"
    printf '已创建日志窗口。使用 ./bot attach 进入；Ctrl+B 后按 D 暂离。\n'
}

case "${1:-open}" in
    open)
        open_log_view
        exec "$bot_script" attach
        ;;
    # runit 的入口：与 start 同一套准备，但不带前台控制台、不加启动锁
    # （runsv 已保证单实例；加锁会被派生出的 Chromium 继承，见 prepare_runtime）。
    serve)
        prepare_runtime nolock
        exec "$bot_exe"
        ;;
    start)
        if runit_managed; then
            sv up "$bot_session"
            printf '已请求 runit 启动；日志见 ./bot logs。\n'
            exit 0
        fi
        prepare_runtime
        exec "$bot_exe" --console
        ;;
    # 手动前台启动（带控制台），调试用。托管时请先 ./bot stop 再跑。
    console)
        prepare_runtime
        exec "$bot_exe" --console
        ;;
    status|s)
        if runit_managed; then sv status "$bot_session" 2>&1 || true; fi
        pids=$(running_pids)
        printf '日志：%s\n' "$bot_log"
        if [[ -n "$pids" ]]; then
            printf 'ayjx 运行中，PID：%s\n' "$pids"
            printf '插件状态：./bot logs 看日志；连接状态请查看 Satori 日志。\n'
        else
            printf 'ayjx 已停止。\n'
            exit 3
        fi
        ;;
    stop|down)
        if runit_managed; then
            # 只能走 sv down：直接 kill 的话 runsv 会在一秒内把它拉回来。
            # 根侧看守盯的是 Termux 监督树而不是 bot，所以这里停掉是稳的。
            sv down "$bot_session"
            if wait_gone; then
                printf 'ayjx 已停止，runit 已置 down，不会被自动拉起。\n'
                printf '恢复：./bot start（或 sv up %s）。\n' "$bot_session"
            else
                printf '停止超时，请用 ./bot logs 查看退出日志。\n' >&2
                exit 1
            fi
        else
            stop_bot
        fi
        ;;
    restart)
        if runit_managed; then
            sv restart "$bot_session"
            printf '已请求 runit 重启；日志见 ./bot logs。\n'
        else
            stop_bot
            exec "$bot_dir/bot" console
        fi
        ;;
    enable|on)
        sv-enable "$bot_session"
        printf '已设为随 Termux 监督树自启。\n'
        ;;
    disable|off)
        if [[ -n "$(running_pids)" ]]; then
            printf 'bot 运行中，请先 ./bot stop。\n' >&2
            exit 1
        fi
        sv-disable "$bot_session"
        printf '已取消自启；当前会话内不会被拉起，Termux 重启后也不起。\n'
        ;;
    logs|log|session|up)
        open_log_view
        ;;
    attach|a)
        if [[ -z "${TERM:-}" || "${TERM:-}" == dumb ]]; then export TERM=xterm-256color; fi
        exec tmux attach-session -t "=$bot_session-log"
        ;;
    # 手动收一次浏览器僵尸（启动时也会自动收，见 reap_orphan_browsers）。
    reap)
        reap_orphan_browsers
        printf '已检查并清理孤儿浏览器进程。\n'
        ;;
    power)
        case "${2:-help}" in
            on) termux-wake-lock ;;
            off)
                if [[ -n "$(running_pids)" ]]; then
                    printf 'bot 运行中，请先 bot stop 再释放保活锁。\n' >&2
                    exit 1
                fi
                termux-wake-unlock
                ;;
            *) printf 'bot power on 保持熄屏运行；bot power off 停止后释放 Termux 共享唤醒锁（影响其它 Termux 任务）。\n' ;;
        esac
        ;;
    help|-h|--help)
        printf './bot          看日志（未创建日志窗口时先创建再进入）\n'
        printf './bot logs     只看日志窗口，不进入\n./bot attach   进入日志窗口（Ctrl+B 后按 D 暂离）\n'
        printf './bot status   查看 runit 与进程状态\n'
        printf './bot stop     优雅停止；runit 托管时走 sv down，不会被自动拉起\n'
        printf './bot restart  优雅重启\n./bot start    启动（runit 托管时等价 sv up）\n'
        printf './bot console  手动前台启动（带控制台），调试用\n'
        printf './bot enable   随 Termux 监督树自启；./bot disable 取消\n'
        printf './bot reap     收掉父进程已不在的 cdp-shot 浏览器进程（启动时自动做）\n'
        printf './bot power    Termux 熄屏保活说明\n'
        if [[ -e "$revive_log" ]]; then
            printf '\n看守盯的是 Termux 监督树而不是 bot，所以 ./bot stop 不会被它抢回去。\n'
            printf '要连 Termux 一起停，两种都算「你手动停」，看守不会复活它：\n'
            printf '  强行停止 Termux（下次打开 Termux 即恢复），或\n'
            printf '  su -c "%s hold"（一直别起来，要 resume 才恢复）。\n' "$revive"
            printf '被动被杀（ColorOS 清理器 / 内存 / 崩溃）才会自动拉起来；判据自检 su -c "%s --check"。\n' "$revive"
        fi
        ;;
    *) printf '未知操作，使用 ./bot help。\n' >&2; exit 2 ;;
esac
